{#
  hotel-classic — theme strings (research R-08, data-model.md §5).

  Every guest-visible string that is NOT survey content (entered per language
  in the LimeSurvey admin) lives here: navigation labels, progress step text,
  the optional marker, the required-answer message, the placeholder notice,
  the language label, the confirmation-icon label and the brand strings.

  Usage in a view:
      {% import './subviews/hotel/i18n.twig' as i18n %}
      {{ i18n.t('nav.continue', aSurveyInfo.languagecode) }}

  IMPORTANT (Twig 3 macro isolation): macros cannot see variables that are
  declared at the top level of a template file, so the string map lives inside
  the macro that uses it. Brand strings are defined ONLY here (FR-030) —
  brand.twig reads them through this macro.

  The Persian strings are a PROPOSAL pending review by a fluent Persian
  speaker (spec A-05, plan risks R4 and R3).
#}

{#
  t(key, lang) — look up a theme string.
  * lang must be 'en' or 'fa'; any other value falls back to 'en'.
  * a missing key never falls back to English: the key itself is returned so
    that a missing translation is obvious in review instead of silently
    showing the wrong language (FR-007).
#}
{% macro t(key, lang) %}
{%- set strings = {
  'nav.back': {'en': 'Back', 'fa': 'قبلی'},
  'nav.continue': {'en': 'Continue', 'fa': 'ادامه'},
  'nav.submit': {'en': 'Submit', 'fa': 'ارسال'},
  'nav.start': {'en': 'Start survey', 'fa': 'شروع نظرسنجی'},
  'progress.step': {'en': 'Question %1 of %2', 'fa': 'پرسش %1 از %2'},
  'question.optional': {'en': 'Optional', 'fa': 'اختیاری'},
  'question.required': {'en': 'Required', 'fa': 'الزامی'},
  'question.required_msg': {'en': 'Please choose an answer to continue.', 'fa': 'لطفاً برای ادامه یک گزینه را انتخاب کنید.'},
  'notice.placeholder': {'en': 'Development preview – placeholder brand', 'fa': 'پیش‌نمایش توسعه – نام تجاری موقت'},
  'lang.label': {'en': 'Language', 'fa': 'زبان'},
  'nojs.alert': {'en': 'Caution: JavaScript is turned off in your browser. Some parts of the survey may not work. Please turn JavaScript on.', 'fa': 'هشدار: جاوااسکریپت در مرورگر شما خاموش است. ممکن است برخی بخش‌های نظرسنجی کار نکنند. لطفاً جاوااسکریپت را روشن کنید.'},
  'done.icon_label': {'en': 'Feedback received', 'fa': 'نظر شما دریافت شد'},
  'error.title': {'en': 'This page can no longer be shown', 'fa': 'این صفحه دیگر قابل نمایش نیست'},
  'error.message': {'en': 'Your session may have expired, or the request could not be processed. Please open the survey link again to start a new survey.', 'fa': 'ممکن است نشست شما منقضی شده باشد یا درخواست شما پردازش نشده باشد. لطفاً پیوند نظرسنجی را دوباره باز کنید تا نظرسنجی تازه‌ای آغاز شود.'},
  'error.contact': {'en': 'For further information please contact the hotel:', 'fa': 'برای اطلاعات بیشتر با هتل تماس بگیرید:'},
  'error.page_title': {'en': 'Survey unavailable', 'fa': 'نظرسنجی در دسترس نیست'},
  'menu': {'en': 'Menu', 'fa': 'منو'},
  'notifications': {'en': 'Notifications', 'fa': 'اعلان‌ها'},
  'tab.home': {'en': 'Home', 'fa': 'خانه'},
  'tab.nearby': {'en': 'Nearby', 'fa': 'اطراف'},
  'tab.rate': {'en': 'Rate', 'fa': 'نظرسنجی'},
  'tab.dash': {'en': 'Dashboard', 'fa': 'داشبورد'},
  'tab.services': {'en': 'Services', 'fa': 'خدمات'},
  'nav.main': {'en': 'Main', 'fa': 'منوی اصلی'},
  'title.rate': {'en': 'Rate your stay', 'fa': 'نظر شما دربارهٔ اقامت'},
  'd.mystay': {'en': 'My stay', 'fa': 'اقامت من'},
  'd.room': {'en': 'Room service', 'fa': 'سرویس اتاق'},
  'd.wifi': {'en': 'Wi-Fi', 'fa': 'وای‌فای'},
  'd.settings': {'en': 'Settings', 'fa': 'تنظیمات'},
  'd.soon': {'en': 'Soon', 'fa': 'به‌زودی'},
  'd.lang': {'en': 'Language', 'fa': 'زبان'},
  'd.langLocked': {'en': 'Locked while the survey is open', 'fa': 'تا پایان نظرسنجی قابل تغییر نیست'},
  'demo': {'en': 'Demo build · placeholder brand', 'fa': 'نسخهٔ نمایشی · نام تجاری موقت'},
  'soon': {'en': 'Coming soon in the full app', 'fa': 'به‌زودی در نسخهٔ کامل'},
  'lang.en': {'en': 'English', 'fa': 'English'},
  'lang.fa': {'en': 'فارسی', 'fa': 'فارسی'},
  's.time': {'en': 'About 2 minutes', 'fa': 'حدود ۲ دقیقه'},
  's.anon': {'en': 'Anonymous', 'fa': 'بدون نام'},
  's.q9': {'en': '9 questions', 'fa': '۹ پرسش'},
  's.langNote': {'en': 'The survey stays in English once you start.', 'fa': 'پس از شروع، نظرسنجی به فارسی می‌ماند.'},
  's.done.home': {'en': 'Back to home', 'fa': 'بازگشت به خانه'},
  's.done.nearby': {'en': 'Explore nearby', 'fa': 'گشتی در اطراف'},
  'brand.name_en': {'en': 'Paradise Garden Hotel', 'fa': 'Paradise Garden Hotel'},
  'brand.name_fa': {'en': 'باغ پردیس', 'fa': 'باغ پردیس'},
  'brand.tagline': {'en': 'Your experience matters', 'fa': 'تجربهٔ شما برای ما ارزشمند است'}
} -%}
{%- set l = lang -%}
{%- if l != 'en' and l != 'fa' -%}
  {%- set l = 'en' -%}
{%- endif -%}
{%- if strings[key] is defined -%}
  {{- strings[key][l] -}}
{%- else -%}
  {{- key -}}
{%- endif -%}
{% endmacro %}

{#
  digits(n, lang) — render a number, converting 0-9 to the Persian digits
  ۰-۹ for Persian screens while the persianDigits constant is true
  (research R-05, open digit-style decision R3). Stored answer codes are
  always Western digits; this only affects what the guest sees.
#}
{% macro digits(n, lang) %}
{%- set persianDigits = true -%}
{%- set s = n ~ '' -%}
{%- if lang == 'fa' and persianDigits -%}
  {{- s|replace({'0': '۰', '1': '۱', '2': '۲', '3': '۳', '4': '۴', '5': '۵', '6': '۶', '7': '۷', '8': '۸', '9': '۹'}) -}}
{%- else -%}
  {{- s -}}
{%- endif -%}
{% endmacro %}
