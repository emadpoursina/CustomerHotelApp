{#
  hotel-classic — list (radio) answer group (WCAG 1.3.1, T044 accessibility check).
  Core view copied from LimeSurvey CE 6.17.18 application/views/survey/questions/answer/listradio/answer.twig
  and changed in one place: the radiogroup role moves from the <ul> to a wrapping <div>.
  A <ul> with role="radiogroup" drops list semantics, so its <li> rows fail axe "listitem".
  The ul keeps its core classes and data attributes, so hotel.css selectors (.hotel-scale ul) still match.
#}

<!-- List Radio -->

<!-- answer -->
{{ sTimer }}
<div role="radiogroup" aria-labelledby="ls-question-text-{{ name }}">
<ul class="{{ coreClass }} list-unstyled {% if iNbCols > 1 %} ls-column-count-{{iNbCols}}{% endif %}"{% if iNbCols > 1 %} data-column-count={{iNbCols}}{% endif %}>
    {# rows/answer_row.php #}
    {{ sRows }}
</ul>
</div>
{# Value for expression manager javascript (use id) ; no need to submit #}
{{ C.Html.hiddenField("java"~name,value,({
    'id' : "java"~name,
    'disabled' : true,
}))
}}
<!-- end of answer -->
