    <surveyls_language><![CDATA[en]]></surveyls_language>
    <surveyls_title><![CDATA[Kowsar Malekshahr Complex – Guest survey]]></surveyls_title>
    <surveyls_description><![CDATA[Development placeholder brand]]></surveyls_description>
    <surveyls_welcometext><![CDATA[<p class="hotel-welcome-message">We would be delighted if you could take two minutes to share your experience with us.</p>
<p class="hotel-welcome-intro">Your answers are anonymous. We never ask for your name or contact details.</p>
<p class="hotel-welcome-time">About 2 minutes</p>]]></surveyls_welcometext>
    <surveyls_endtext><![CDATA[<h2 class="hotel-done-heading">Thank you</h2>
<p class="hotel-done-message">Thank you for taking the time to share your experience. Your feedback helps us make every stay more special.</p>]]></surveyls_endtext>
