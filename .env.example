# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# --- Database (MariaDB) ---
DB_NAME=hotel_survey
DB_USER=hotel_survey
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# --- LimeSurvey administrator (first-run account) ---
LS_ADMIN_USER=admin
LS_ADMIN_PASSWORD=CHANGE_ME
LS_ADMIN_NAME="Hotel Management"
LS_ADMIN_EMAIL=management@hotel.example

# --- Public URL of the survey (used in generated QR codes) ---
# Local: served by the shared Caddy. Phones on the same Wi-Fi cannot reach *.localhost (see docs/decisions.md).
PUBLIC_URL=http://hotelsurvey.localhost

# --- Host port LimeSurvey is published on (Caddy proxies to this) ---
SURVEY_PORT=8090

# --- Deploy to the production server (make deploy / scripts/deploy.sh). See docs/deployment.md ---
# DEPLOY_HOST=root@85.198.52.136
# DEPLOY_PATH=/opt/hotel-survey
DEPLOY_HOST=
DEPLOY_PATH=
DEPLOY_PORT=22

# --- Optional: override the locally built LimeSurvey image tag (base image: docker/limesurvey/Dockerfile) ---
# LIMESURVEY_IMAGE=hotel-survey/limesurvey:6-apache

# --- Nearby places: Neshan Maps Platform (Nearby + POI Details), called server-side by app/api/places.php ---
# Setup steps and checks: docs/neshan-places.md. Leave the key empty to use the bundled demo data.
NESHAN_API_KEY=
# Location of the complex (required for live data). Get them from the map: right-click the complex.
HOTEL_LAT=
HOTEL_LNG=
HOTEL_TIMEZONE=Asia/Tehran
# Search radius in metres (100-50000), places per category (1-20), cache lifetime in seconds (60-86400).
PLACES_RADIUS_M=2000
PLACES_MAX_PER_CATEGORY=12
PLACES_CACHE_TTL=900

# --- Manager notifications: Bale messenger bot (called server-side by app/api/inbox.php) ---
# Leave BALE_BOT_TOKEN or BALE_CHAT_ID empty to skip sending. Never commit real tokens.
BALE_BOT_TOKEN=
BALE_CHAT_ID=
# Optional API base (default https://tapi.bale.ai, no trailing slash).
BALE_API_BASE=https://tapi.bale.ai
