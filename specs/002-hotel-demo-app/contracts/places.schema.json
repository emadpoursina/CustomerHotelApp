{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hotel-survey/places.schema.json",
  "title": "Nearby places (DEMO DATA, fictional)",
  "description": "Format of app/data/places.json. Data is fictional and must stay marked demo: true. See data-model.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["demo", "note", "highlights", "places"],
  "properties": {
    "demo": { "const": true },
    "note": { "type": "string", "minLength": 1 },
    "highlights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "places": {
      "type": "array",
      "minItems": 18,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/place" }
    }
  },
  "$defs": {
    "text2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fa"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fa": { "type": "string", "minLength": 1 }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "name", "distance_m", "rating", "price", "hours", "tags", "description"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["restaurant", "cafe", "poi"] },
        "name": { "$ref": "#/$defs/text2" },
        "distance_m": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "price": { "type": "integer", "minimum": 1, "maximum": 3 },
        "hours": {
          "description": "[open, close] in decimal hours; close > 24 means after midnight; [0, 24] means 24 hours. Rule: 0 <= open < close <= 48.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 48 }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "fa"],
          "properties": {
            "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "fa": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "description": { "$ref": "#/$defs/text2" }
      }
    }
  }
}
