{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hotel-survey/dashboard.schema.json",
  "title": "Dashboard snapshot v2 (aggregates + department slices, no comments)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "surveyId", "ranges", "byDepartment"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "surveyId": { "type": "integer", "minimum": 1 },
    "ranges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["7d", "30d", "all"],
      "properties": {
        "7d": { "$ref": "#/$defs/range" },
        "30d": { "$ref": "#/$defs/range" },
        "all": { "$ref": "#/$defs/range" }
      }
    },
    "byDepartment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restaurant", "reception", "facilities", "housekeeping"],
      "properties": {
        "restaurant": { "$ref": "#/$defs/ranges" },
        "reception": { "$ref": "#/$defs/ranges" },
        "facilities": { "$ref": "#/$defs/ranges" },
        "housekeeping": { "$ref": "#/$defs/ranges" }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "ranges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["7d", "30d", "all"],
      "properties": {
        "7d": { "$ref": "#/$defs/range" },
        "30d": { "$ref": "#/$defs/range" },
        "all": { "$ref": "#/$defs/range" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "languages", "categories", "nps"],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "fa", "other"],
          "properties": {
            "en": { "$ref": "#/$defs/count" },
            "fa": { "$ref": "#/$defs/count" },
            "other": { "$ref": "#/$defs/count" }
          }
        },
        "categories": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/category" }
        },
        "nps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n", "promoters", "passives", "detractors", "score"],
          "properties": {
            "n": { "$ref": "#/$defs/count" },
            "promoters": { "$ref": "#/$defs/count" },
            "passives": { "$ref": "#/$defs/count" },
            "detractors": { "$ref": "#/$defs/count" },
            "score": { "type": ["integer", "null"], "minimum": -100, "maximum": 100 }
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "code", "n", "sum", "avg"],
      "properties": {
        "key": { "enum": ["overall", "cleanliness", "comfort", "staff", "breakfast", "facilities"] },
        "code": { "enum": ["Q1OVERALL", "Q2CLEAN", "Q3COMFORT", "Q4STAFF", "Q5BREAKFAST", "Q6FACILITIES"] },
        "n": { "$ref": "#/$defs/count" },
        "sum": { "$ref": "#/$defs/count" },
        "avg": { "type": ["number", "null"], "minimum": 1, "maximum": 5 }
      }
    }
  }
}
